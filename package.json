{
  "name": "soltex-global",
  "private": true,
  "type": "module",
  "description": "Soltex Global monorepo: public site (apps/web), admin (apps/admin), API (apps/api), shared core (packages/core).",
  "workspaces": [
    "apps/web",
    "apps/admin",
    "apps/api",
    "packages/core"
  ],
  "scripts": {
    "dev": "npm run dev -w @soltex/web",
    "dev:web": "npm run dev -w @soltex/web",
    "dev:admin": "npm run dev -w @soltex/admin",
    "dev:api": "npm run dev -w @soltex/api",
    "content": "npm run content -w @soltex/web",
    "build": "npm run build -w @soltex/web",
    "build:web": "npm run build -w @soltex/web",
    "build:admin": "npm run build -w @soltex/admin",
    "build:all": "npm run build:web && npm run build:admin",
    "validate": "npm run validate -w @soltex/web",
    "serve:dist": "npm run serve:dist -w @soltex/web",
    "preview": "npm run preview -w @soltex/web",
    "typecheck": "npm run lint -w @soltex/web && npm run typecheck -w @soltex/admin -w @soltex/api -w @soltex/core",
    "check:deps": "node scripts/check-deps.mjs",
    "lint": "npm run typecheck && npm run check:deps",
    "test": "npm run test -w @soltex/core -w @soltex/api",
    "test:db": "npm run test:db -w @soltex/api",
    "db:migrate": "npm run db:migrate -w @soltex/api",
    "db:import": "npm run db:import -w @soltex/api",
    "db:export": "npm run db:export -w @soltex/api --",
    "qa": "node scripts/qa-regression.mjs",
    "clean": "npm run clean -w @soltex/web && rm -rf apps/admin/dist .qa"
  }
}
