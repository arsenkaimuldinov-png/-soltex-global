# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# -----------------------------------------------------------------------------
# NOTE: the two variables above are legacy from the AI Studio template. The site does
# not read them; they are kept unchanged (legacy is not removed without approval).
#
# Variables the public site build actually reads (none of them is secret; they end up
# in the generated HTML):
# -----------------------------------------------------------------------------
# VITE_SITE_URL=https://soltexglobal.co   # absolute URLs (canonical, hreflang, sitemap, OG)
# MEDIA_BASE_URL=                         # optional media host; empty = same origin
# CONTENT_SOURCE=seed                     # content source of the build (Phase 1: seed)
# DISABLE_HMR=                            # dev server only
