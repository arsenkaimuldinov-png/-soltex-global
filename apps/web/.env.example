# -----------------------------------------------------------------------------
# Variables the public site build actually reads (none of them is secret; they end up
# in the generated HTML):
# -----------------------------------------------------------------------------
# VITE_SITE_URL=https://soltexglobal.co   # absolute URLs (canonical, hreflang, sitemap, OG)
# MEDIA_BASE_URL=                         # optional media host; empty = same origin
# CONTENT_SOURCE=seed                     # content source of the build: seed (default) or file
# CONTENT_STORE_FILE=                     # with CONTENT_SOURCE=file: path to a content store JSON (db:export --file)
# DISABLE_HMR=                            # dev server only
