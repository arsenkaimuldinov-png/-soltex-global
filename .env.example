# =============================================================================
# Soltex Global: environment variables (template). NO REAL VALUES IN THIS FILE.
# Copy to .env.<environment> locally (git-ignored) or set the variables in the
# environment of the process (systemd EnvironmentFile on the server, CI secrets).
# Source of truth: docs/admin-architecture-approved.md; see also
# docs/admin-architecture-implementation.md (Phase A).
#
# Environments: development · test · production (NODE_ENV). Each environment has its
# own file and its own database; production values never leave the server.
# =============================================================================

# --- Shared ------------------------------------------------------------------
NODE_ENV=development            # development | test | production

# --- apps/web (public site build; values are NOT secret, they end up in HTML) -
# See apps/web/.env.example for the full list.
VITE_SITE_URL=https://soltexglobal.co
# MEDIA_BASE_URL=               # optional CDN / media host; empty = same origin
CONTENT_SOURCE=seed             # seed (default) | file (database export, Phase B); preview from Phase H

# --- apps/api (Phase A uses only these) -----------------------------------------
API_HOST=127.0.0.1              # loopback only; nginx is the public entry point
API_PORT=3100
API_LOG_LEVEL=info              # fatal | error | warn | info | debug | trace | silent

# --- Database (Phase B; roles from apps/api/db/provision.sql) -------------------
# Application role: data read/write only. Used by the API, the worker and db:import / db:export.
DATABASE_URL=postgres://soltex_app:<secret>@127.0.0.1:5432/soltex
# Migration role: schema owner. Used ONLY by `npm run db:migrate` (deploy step); never by the API.
MIGRATION_DATABASE_URL=postgres://soltex_migrate:<secret>@127.0.0.1:5432/soltex
# Backup role: read-only. Used by backup jobs (Phase N) and the role test.
BACKUP_DATABASE_URL=postgres://soltex_backup:<secret>@127.0.0.1:5432/soltex
# Site build from a database export (Phase B): CONTENT_SOURCE=file CONTENT_STORE_FILE=/path/store.json

# --- Reserved for later phases (do not set yet) ------------------------------
# Phase C  SESSION_SECRET / DATA_ENCRYPTION_KEY / WEBAUTHN_RP_ID=admin.soltexglobal.co
# Phase J  MEDIA_STORAGE_DIR=/srv/soltex/media
# Phase K  SMTP_URL=smtp://<user>:<secret>@<host>:587 · LEAD_NOTIFY_FROM · ATTRIBUTION_ENABLED=false
# Phase N  backup repository and encryption settings (kept outside the application env)
