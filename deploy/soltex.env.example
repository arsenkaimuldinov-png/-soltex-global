# /etc/soltex/soltex.env — environment of soltex-api, soltex-worker and soltex-preview (Phase N-0).
# Copy, fill the <…> values, then: chown root:soltex /etc/soltex/soltex.env && chmod 640 /etc/soltex/soltex.env
# systemd reads this file literally: no inline comments after values, no quotes around values,
# no `export`. Meaning of every variable: the root .env.example. Secrets are generated with
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Never put MIGRATION_DATABASE_URL or BACKUP_DATABASE_URL here (separate files, separate roles).

NODE_ENV=production
API_HOST=127.0.0.1
API_PORT=3100
API_LOG_LEVEL=info
API_DOCS=off

DATABASE_URL=postgres://soltex_app:<app-password>@127.0.0.1:5432/soltex

ADMIN_ORIGIN=https://admin.soltexglobal.co
WEBAUTHN_RP_ID=admin.soltexglobal.co
WEBAUTHN_RP_NAME=Soltex Global Admin
DATA_ENCRYPTION_KEYS=k1:<32 random bytes, base64>
DATA_ENCRYPTION_KEY_ID=k1
HASH_SECRET=<32 random bytes, base64>
SESSION_COOKIE_SECURE=true
MFA_FOR_ALL_ROLES=false

RELEASES_DIR=/srv/soltex
MEDIA_DIR=/srv/soltex/media
PREVIEW_ORIGIN=https://preview.soltexglobal.co
PREVIEW_PORT=3102
PUBLIC_SITE_URL=https://soltexglobal.co

# E-mail (client: SMTP server, sender, recipients of lead notices). Without SMTP_URL mail waits in
# the outbox and nothing is lost. The server must offer STARTTLS (TLS 1.2+) or use smtps://.
# SMTP_URL=smtp://<user>:<password>@<smtp-host>:587
# MAIL_FROM=Soltex Global <noreply@soltexglobal.co>
# LEAD_NOTIFY_TO=<sales@…>

LEAD_RETENTION_MONTHS=24
# Version (date) of the Privacy Policy published on the site. While set, every lead must carry the
# visitor's consent (the consent box of the forms, shown once the policy page is published).
PRIVACY_NOTICE_VERSION=2026-10-19
# Site forms: false until the client approves the privacy texts; the next published release applies it.
SITE_LEADS_ENABLED=false
ATTRIBUTION_ENABLED=false

# Backups (deploy/scripts/backup.sh writes the time of its last success here; «Система» shows it).
BACKUP_STATUS_FILE=/var/lib/soltex-backup/status
