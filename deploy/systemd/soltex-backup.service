# Soltex Global — nightly backup: database dump + media snapshots (releases are rebuilt from the database) (Phase N-0, docs/deploy-runbook-ru.md).
[Unit]
Description=Soltex Global backup
After=postgresql.service

[Service]
Type=oneshot
User=soltex-backup
Group=soltex-backup
# BACKUP_DATABASE_URL, BACKUP_DIR, BACKUP_KEEP_DAYS, optional BACKUP_REMOTE (see deploy/backup.env.example).
EnvironmentFile=/etc/soltex/backup.env
ExecStart=/opt/soltex/app/deploy/scripts/backup.sh
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/backups/soltex /var/lib/soltex-backup
