# /etc/soltex/backup.env — soltex-backup.service (root:soltex-backup 640).
BACKUP_DATABASE_URL=postgres://soltex_backup:<backup-password>@127.0.0.1:5432/soltex
BACKUP_DIR=/var/backups/soltex
MEDIA_DIR=/srv/soltex/media
BACKUP_KEEP_DAYS=14
# Time of the last success, read by the API («Система» in the admin). Same value as in soltex.env.
BACKUP_STATUS_FILE=/var/lib/soltex-backup/status
# Offsite copy (client decision: where). An rsync target reachable with the soltex-backup user's SSH key:
# BACKUP_REMOTE=backup@<host>:/srv/backups/soltex
